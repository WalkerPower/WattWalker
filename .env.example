# Copy this file to `.env` in the project root (same folder as package.json).
# NEVER commit `.env` — it is gitignored. Only commit this `.env.example` with empty values.
#
# Create a Gemini key: https://aistudio.google.com/apikey

# Required for local dev + production backend (server-side bill analysis):
GEMINI_API_KEY=

# Optional — only if you run `npm run dev` WITHOUT `npm run dev:api` (not recommended):
# VITE_GEMINI_API_KEY=

# Public URL after deploy (Stripe return URLs, share links). Default: https://newwattwalker.web.app
# VITE_PUBLIC_APP_URL=https://newwattwalker.web.app

# Production API URL (only if UI and API are on different hosts):
# VITE_API_BASE_URL=https://your-api-domain.example.com
